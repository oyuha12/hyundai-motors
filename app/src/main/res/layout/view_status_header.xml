<?xml version="1.0" encoding="utf-8"?>
<!-- Status screen header: the only red area. Report time and the guidance step still running. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:backgroundTint="@color/emergency_critical"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/card_padding"
    android:paddingVertical="@dimen/gap_large">

    <ImageView
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_sos"
        app:tint="@color/on_emergency" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_large"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_title"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/on_emergency" />

        <TextView
            android:id="@+id/status_reported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.BodyStrong"
            android:textColor="@color/on_emergency" />

        <TextView
            android:id="@+id/status_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/on_emergency_variant" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Demo route guidance for PC emulators, where the navigation app cannot load maps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/route_demo_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_navigation"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/route_demo_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:id="@+id/route_demo_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_demo_notice"
                android:textAppearance="@style/TextAppearance.App.LabelSmall"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/route_demo_close"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/route_demo_close"
            app:icon="@drawable/ic_close" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1">

        <io.github.oyuha12.hyundaimotors.demo.RouteMapView
            android:id="@+id/route_demo_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        app:cardBackgroundColor="@color/primary_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/gap_large">

            <TextView
                android:id="@+id/route_demo_turn_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/primary"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textColor="@color/on_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_large"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/route_demo_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.App.TitleLarge"
                    android:textColor="@color/on_primary_container" />

                <TextView
                    android:id="@+id/route_demo_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_primary_container" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/route_demo_pause"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/route_demo_restart"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:text="@string/route_demo_restart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

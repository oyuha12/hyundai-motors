<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_label"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/core_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/status_normal"
                    android:textAppearance="@style/TextAppearance.App.Display" />

                <TextView
                    android:id="@+id/core_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_nearby"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/open_nearby" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/telemetry_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Widget.App.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_speed"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                <TextView
                    android:id="@+id/tile_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/value_unknown"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:textColor="@color/on_surface" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.App.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_gear"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                <TextView
                    android:id="@+id/tile_gear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/value_unknown"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:textColor="@color/on_surface" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.App.Tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_brake"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                <TextView
                    android:id="@+id/tile_brake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/value_unknown"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:textColor="@color/on_surface" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

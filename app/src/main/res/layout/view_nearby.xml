<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:id="@+id/nearby_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <TextView
            android:id="@+id/route_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/primary_container"
            android:padding="@dimen/gap"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/on_primary_container"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large">

            <LinearLayout
                android:id="@+id/facility_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/gap"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="@dimen/gap" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

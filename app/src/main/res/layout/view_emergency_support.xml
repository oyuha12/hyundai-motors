<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout style="@style/Widget.App.CardContent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/evacuation_icon"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_marginEnd="@dimen/gap"
                    android:importantForAccessibility="no"
                    app:tint="@color/negative" />

                <TextView
                    android:id="@+id/evacuation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/evacuation_title"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:textColor="@color/on_surface" />
            </LinearLayout>

            <TextView
                android:id="@+id/evacuation_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <TextView
                android:id="@+id/evacuation_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_large"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.TitleLarge"
                android:textColor="@color/negative" />

            <TextView
                android:id="@+id/evacuation_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/emergency_route_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/primary"
                android:visibility="gone" />

            <!-- Turn by turn from the navigation app while it guides our route. -->
            <TextView
                android:id="@+id/emergency_next_turn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/on_surface_variant"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

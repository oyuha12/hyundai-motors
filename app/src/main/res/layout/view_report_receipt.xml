<?xml version="1.0" encoding="utf-8"?>
<!-- Report receipt: shown once a report is recorded. The report itself reaches no one. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/report_receipt"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap"
    android:visibility="gone"
    app:cardBackgroundColor="@color/success_container">

    <LinearLayout style="@style/Widget.App.CardContent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/success" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_receipt_title"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_receipt_agencies"
                    android:textAppearance="@style/TextAppearance.App.BodyStrong" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/report_receipt_sent"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/on_surface_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/receipt_label_width"
                android:layout_height="wrap_content"
                android:text="@string/report_receipt_location"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <TextView
                android:id="@+id/receipt_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/receipt_label_width"
                android:layout_height="wrap_content"
                android:text="@string/report_receipt_situation"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <TextView
                android:id="@+id/receipt_situation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/receipt_label_width"
                android:layout_height="wrap_content"
                android:text="@string/report_receipt_time"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <TextView
                android:id="@+id/receipt_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/receipt_label_width"
                android:layout_height="wrap_content"
                android:text="@string/report_receipt_speed"
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            <TextView
                android:id="@+id/receipt_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </LinearLayout>

        <!-- Hidden in video mode, like the other test notices. -->
        <TextView
            android:id="@+id/receipt_test_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/report_receipt_test_notice"
            android:textAppearance="@style/TextAppearance.App.LabelSmall"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/receipt_open_status"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/receipt_open_status"
            app:icon="@drawable/ic_location_on" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

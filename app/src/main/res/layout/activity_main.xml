<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow window: one column with bottom navigation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        layout="@layout/view_main_column"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundTint="@color/surface"
        app:itemIconSize="@dimen/icon_size"
        app:itemTextAppearanceActive="@style/TextAppearance.App.Nav"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.Nav"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/nav_destinations" />
</LinearLayout>

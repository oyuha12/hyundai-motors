<?xml version="1.0" encoding="utf-8"?>
<!-- Hidden demo menu for filming, opened by a long press on the app title in video mode. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/card_padding"
        android:paddingTop="@dimen/gap"
        android:paddingBottom="@dimen/gap">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_menu_lead_in"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/video_lead_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/video_skip_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:minHeight="@dimen/touch_target"
            android:text="@string/video_menu_skip_confirmation"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/video_staged_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/video_menu_staged_voice"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/video_menu_auto_route"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/video_auto_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/video_fallback_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/video_menu_fallback_route"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <!-- Reads a test sentence; the line below says which voice engine read it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/video_voice_test"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:gravity="start|center_vertical"
            android:text="@string/video_menu_voice_test"
            app:icon="@drawable/ic_volume_up" />

        <TextView
            android:id="@+id/video_voice_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.App.LabelSmall"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/video_scenario_acceleration"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:gravity="start|center_vertical"
            android:text="@string/video_menu_acceleration"
            app:icon="@drawable/ic_speed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/video_scenario_fire"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:gravity="start|center_vertical"
            android:text="@string/video_menu_fire"
            app:icon="@drawable/ic_local_fire_department" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/video_scenario_third"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:gravity="start|center_vertical"
            android:text="@string/video_menu_collision"
            app:icon="@drawable/ic_car_crash" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/video_mode_off"
            style="@style/Widget.App.Button.Dev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/video_menu_off"
            app:icon="@drawable/ic_power_settings_new"
            app:iconTint="@color/on_surface_variant" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Asks "is this an emergency?" before the situation screen. Answer by voice or touch.
    Laid out like the Pleos system popup: dimmed screen, centered card, title and description
    centered, buttons stacked vertically (confirm on top, cancel below).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/confirm_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dim"
    android:clickable="true"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/popup_side_padding"
        android:paddingVertical="@dimen/screen_padding">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/popup_padding">

                <TextView
                    android:id="@+id/confirm_mock_banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap_large"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/surface_variant"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="@string/mock_banner"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="@color/on_surface_variant" />

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/emergency_critical">

                    <ImageView
                        android:id="@+id/confirm_icon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:tint="@color/on_emergency" />
                </FrameLayout>

                <TextView
                    android:id="@+id/confirm_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_large"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.App.Headline" />

                <TextView
                    android:id="@+id/confirm_reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_small"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                <TextView
                    android:id="@+id/confirm_voice_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_large"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/surface_variant"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirm_yes"
                    style="@style/Widget.App.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:minHeight="@dimen/popup_button_height"
                    android:text="@string/confirm_yes"
                    android:textAppearance="@style/TextAppearance.App.SituationLabel"
                    app:icon="@drawable/ic_check_circle"
                    app:iconSize="@dimen/icon_size_large" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirm_no"
                    style="@style/Widget.App.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:minHeight="@dimen/popup_button_height"
                    android:text="@string/confirm_no"
                    android:textAppearance="@style/TextAppearance.App.SituationLabel"
                    app:icon="@drawable/ic_close"
                    app:iconSize="@dimen/icon_size_large" />

                <TextView
                    android:id="@+id/confirm_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_large"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Red header panel: the only large red area, as Pleos keeps screens neutral. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:backgroundTint="@color/emergency_critical"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/emergency_mock_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_large"
            android:background="@drawable/bg_pill_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mock_banner"
            android:textAppearance="@style/TextAppearance.App.LabelSmall"
            android:textColor="@color/on_emergency_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/emergency_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                app:tint="@color/on_emergency" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_large"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emergency_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:textColor="@color/on_emergency" />

                <TextView
                    android:id="@+id/emergency_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_emergency_variant" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large">

        <LinearLayout style="@style/Widget.App.CardContent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/emergency_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/negative" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/emergency_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap"
                    android:layout_weight="1"
                    app:indicatorColor="@color/negative"
                    app:trackColor="@color/surface_variant"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_large"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Step picture. The inner frame loops a short motion while parked. -->
                <FrameLayout
                    android:layout_width="@dimen/step_symbol_size"
                    android:layout_height="@dimen/step_symbol_size"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/emergency_critical"
                    android:clipChildren="true">

                    <FrameLayout
                        android:id="@+id/emergency_step_visual"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/emergency_step_icon"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:tint="@color/on_emergency" />

                        <TextView
                            android:id="@+id/emergency_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.App.Headline"
                            android:textColor="@color/on_emergency" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/emergency_step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_large"
                    android:layout_weight="1"
                    android:lineHeight="50sp"
                    android:maxLines="4"
                    android:textAppearance="@style/TextAppearance.App.TitleLarge" />
            </LinearLayout>

            <!-- Shown after a step that waits for the car to stop, until it has. -->
            <TextView
                android:id="@+id/emergency_waiting_for_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/waiting_for_stop"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/on_surface_variant"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- One touch reports at once, without a confirmation popup. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/emergency_report"
        style="@style/Widget.App.Button.Emergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:minHeight="@dimen/sos_button_height"
        android:text="@string/emergency_report"
        android:textAppearance="@style/TextAppearance.App.SituationLabel"
        app:icon="@drawable/ic_sos"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_size_large" />

    <!-- Listening for "신고해 줘" after the last step. -->
    <TextView
        android:id="@+id/report_voice_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        android:gravity="center_horizontal"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/on_surface_variant"
        android:visibility="gone" />

    <!-- What was recognized, like a speech bubble. -->
    <TextView
        android:id="@+id/report_heard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/gap"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/surface_variant"
        android:paddingHorizontal="@dimen/gap_large"
        android:paddingVertical="@dimen/gap"
        android:textAppearance="@style/TextAppearance.App.BodyStrong"
        android:textColor="@color/on_surface"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_volume_up"
        android:drawablePadding="@dimen/gap_small"
        app:drawableTint="@color/on_surface_variant" />

    <include layout="@layout/view_report_receipt" />

    <!-- Mock dispatch requests to one facility. -->
    <TextView
        android:id="@+id/emergency_report_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/success_container"
        android:padding="@dimen/gap"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/on_surface"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emergency_repeat"
            style="@style/Widget.App.Button.EmergencyOutlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/emergency_repeat"
            app:icon="@drawable/ic_volume_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emergency_dismiss"
            style="@style/Widget.App.Button.EmergencyOutlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap"
            android:layout_weight="1"
            android:text="@string/emergency_dismiss"
            app:icon="@drawable/ic_close" />
    </LinearLayout>
</LinearLayout>

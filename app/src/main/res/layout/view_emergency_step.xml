<?xml version="1.0" encoding="utf-8"?>
<!--
    Situation header and the current step. The red header panel is the only red area; the step
    picture, progress and text sit large in the middle of the card. In wide windows the card
    stretches to the window height and centers its content.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Red header panel: the only large red area, as Pleos keeps screens neutral. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:backgroundTint="@color/emergency_critical"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/emergency_mock_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_large"
            android:background="@drawable/bg_pill_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mock_banner"
            android:textAppearance="@style/TextAppearance.App.LabelSmall"
            android:textColor="@color/on_emergency_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/emergency_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                app:tint="@color/on_emergency" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_large"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emergency_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:textColor="@color/on_emergency" />

                <TextView
                    android:id="@+id/emergency_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_emergency_variant" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.App.CardContent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/emergency_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/negative" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/emergency_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap"
                    android:layout_weight="1"
                    app:indicatorColor="@color/negative"
                    app:trackColor="@color/surface_variant"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/gap_large">

                <!-- Step picture: a red sign on a neutral tile. It loops a motion while parked. -->
                <FrameLayout
                    android:layout_width="@dimen/step_symbol_size"
                    android:layout_height="@dimen/step_symbol_size"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/surface_variant"
                    android:clipChildren="true">

                    <FrameLayout
                        android:id="@+id/emergency_step_visual"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/emergency_step_icon"
                            android:layout_width="@dimen/step_icon_size"
                            android:layout_height="@dimen/step_icon_size"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:tint="@color/negative" />

                        <TextView
                            android:id="@+id/emergency_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.App.StepSymbol"
                            android:textColor="@color/negative" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/emergency_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_large"
                    android:gravity="center"
                    android:maxLines="4"
                    android:textAppearance="@style/TextAppearance.App.StepText" />

                <!-- Shown after a step that waits for the car to stop, until it has. -->
                <TextView
                    android:id="@+id/emergency_waiting_for_stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:gravity="center"
                    android:text="@string/waiting_for_stop"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

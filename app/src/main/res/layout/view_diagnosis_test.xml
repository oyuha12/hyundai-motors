<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_title"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:id="@+id/test_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/test_driving_notice"
            android:textAppearance="@style/TextAppearance.App.BodySecondary"
            android:textColor="@color/on_background"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/test_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/test_description"
                android:textAppearance="@style/TextAppearance.App.BodySecondary"
                android:textColor="@color/on_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scenario_ua"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/scenario_ua" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scenario_brake"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/scenario_brake" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scenario_collision"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/scenario_collision" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scenario_overheat"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/scenario_overheat" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scenario_powertrain"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/scenario_powertrain" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Wide window: side navigation with core and detail panes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navigation"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:backgroundTint="@color/surface"
        app:itemTextAppearanceActive="@style/TextAppearance.App.Nav"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.Nav"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/nav_destinations"
        app:menuGravity="center" />

    <include
        layout="@layout/view_main_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>

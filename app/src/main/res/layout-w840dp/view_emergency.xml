<?xml version="1.0" encoding="utf-8"?>
<!--
    Wide window: the step large on the left, filling the height; the SOS button, other actions,
    evacuation route and nearby help on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emergency_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:baselineAligned="false"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="@dimen/screen_padding"
    android:visibility="gone">

    <!-- Stretches the step card to the window height; scrolls only if the text is very long. -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <include layout="@layout/view_emergency_step" />
    </ScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/section_gap"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/view_emergency_actions" />

            <include
                layout="@layout/view_emergency_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
